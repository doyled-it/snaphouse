#!/usr/bin/env bash
# snaphouse command-line entry point.
#
# Dispatches a subcommand to its handler in lib/snaphouse. Handlers are added
# task by task; this skeleton wires the dispatch and the error paths. An unknown
# subcommand prints usage and exits 2.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="${here}/lib${PYTHONPATH:+:${PYTHONPATH}}"

usage() {
    cat >&2 <<'EOF'
usage: snaphouse <command> [args...]

commands:
  pair      pair a phone (hub) or a speaker (vizio|jbl)
  verify    run the on-device health checks
  status    print this machine's status JSON
  update    fetch main, apply site.yml, and verify (self-update)
EOF
}

# Subcommands whose handler module exists today. An unknown subcommand prints
# usage and exits 2 (see main).
wired_command() {
    case "$1" in
        pair | update | verify | status) return 0 ;;
        *) return 1 ;;
    esac
}

# The lib/snaphouse module that handles a subcommand. It matches the command
# name except for `pair`, whose logic lives in snaphouse.pairing.
module_for() {
    case "$1" in
        pair) echo "pairing" ;;
        *) echo "$1" ;;
    esac
}

# The interpreter that runs the handlers. On-device Python runs from the uv-synced
# venv (built by the selfupdate role from pyproject.toml and uv.lock), so later
# tasks can add runtime deps without touching this entry point. The first apply on
# a fresh machine runs before the venv exists; the handlers wired today are
# stdlib-only, so fall back to the system interpreter until the venv is in place.
python_bin() {
    local venv_python="${here}/.venv/bin/python"
    if [ -x "${venv_python}" ]; then
        echo "${venv_python}"
    else
        echo "python3"
    fi
}

main() {
    local cmd="${1:-}"
    if [ -z "${cmd}" ]; then
        usage
        exit 2
    fi
    shift

    if wired_command "${cmd}"; then
        exec "$(python_bin)" -m "snaphouse.$(module_for "${cmd}")" "$@"
    else
        echo "snaphouse: unknown command '${cmd}'" >&2
        usage
        exit 2
    fi
}

main "$@"
