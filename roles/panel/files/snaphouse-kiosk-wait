#!/usr/bin/env bash
# Wait for the hub to answer before the kiosk opens the page. On a cold boot (a
# power cut, the whole house coming up at once) the hub may not be serving yet,
# and Chromium pointed at a dead address paints an error page that never retries.
# So the launcher runs this first: it polls the hub URL and only returns success
# once the hub answers, so the kiosk opens straight onto the room picker and never
# onto a dead page.
#
# The wait is unbounded by default (KIOSK_WAIT_ATTEMPTS=0): if the hub is late it
# keeps polling rather than giving up into an error page. Because the launcher is
# the kiosk service's main process, the service stays active while this polls, so
# a slow hub never reads as a failed unit; the screen simply comes alive the moment
# the hub answers (Review Focus 4). KIOSK_WAIT_ATTEMPTS can be set to a positive
# cap (the tests do this) to bound the loop; the loop then exits non-zero when the
# cap is exhausted, never a false success. PANEL_URL comes from the service
# EnvironmentFile.
set -euo pipefail

url="${PANEL_URL:?PANEL_URL is not set}"
attempts="${KIOSK_WAIT_ATTEMPTS:-0}"
delay="${KIOSK_WAIT_DELAY:-2}"

i=0
while true; do
    i=$((i + 1))
    if curl -fsS --max-time 3 -o /dev/null "${url}"; then
        echo "snaphouse-kiosk-wait: hub answered on attempt ${i}"
        exit 0
    fi
    if [[ "${attempts}" -gt 0 && "${i}" -ge "${attempts}" ]]; then
        echo "snaphouse-kiosk-wait: hub still silent after ${attempts} attempts" >&2
        exit 1
    fi
    echo "snaphouse-kiosk-wait: hub not ready (attempt ${i}), retrying in ${delay}s" >&2
    sleep "${delay}"
done
