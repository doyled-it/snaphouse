[Unit]
Description=Snaphouse control panel kiosk (cage + Chromium)
Documentation=https://github.com/doyled-it/snaphouse
# Wait for the network so the pre-start hub poll has a link to try, and for user
# sessions so logind can seat the compositor.
After=network-online.target systemd-user-sessions.service
Wants=network-online.target
# The kiosk owns tty1: take the VT over from the login prompt rather than fighting
# it, so cage gets the console and a power cut boots straight into the panel.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=kiosk
Group=kiosk
# Open a real login session on tty1 through PAM so logind grants the seat cage
# needs for DRM and input (this is the autologin: no getty, the service is the
# session).
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty1
UtmpMode=user
# PANEL_URL for the wait poll and the kiosk launcher, templated from local config.
EnvironmentFile=/etc/snaphouse/kiosk.env
# Hold off opening the page until the hub answers, but never forever: the wait is
# bounded and always succeeds, so the kiosk still comes up if the hub is late
# (Review Focus 4: boot to the picker even if the hub arrives later).
ExecStartPre=/usr/local/bin/snaphouse-kiosk-wait
ExecStart=/usr/local/bin/snaphouse-kiosk
# Chromium or cage exiting (a crash, a renderer kill) must bring the panel back on
# its own, not wait for a reboot.
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
