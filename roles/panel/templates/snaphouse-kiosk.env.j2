# {{ ansible_managed }}
# The hub URL the control panel opens. It comes from the untracked local config
# (panel_url in /etc/snaphouse/local.yml), so the household's address never lives
# in the repo. Unset it there to fall back to the hub's mDNS name. Set it to the
# hub's reserved IP if .local is not usable at boot on this network.
PANEL_URL={{ panel_url | default('http://house.local/') }}
