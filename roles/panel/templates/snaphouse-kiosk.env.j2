{#
  The page URL is built first (before the first output line) so the file keeps its
  shape. The panel query always goes before any #fragment and is merged with a query
  already in panel_url: panel=1 (panel mode), pid (this panel's id, the inventory
  key, for its settings on the hub), ss (1 or 0, the screensaver fallback), and the
  one wait for day and night (idle and nidle, both day_idle_s) with the quiet hours.
  These are only the fallback for the settings the hub publishes (panel-settings.json).
  The page reads them once at load, so a change to this file restarts the kiosk
  (Restart the kiosk service).
#}
{% set ss_base = panel_url | default('http://house.local/') -%}
{% set ss_cfg = panel_screensaver | default({}) -%}
{% set bl_cfg = panel_backlight | default({}) -%}
{% set ss_wait = ss_cfg.day_idle_s | default(60) -%}
{% set ss_parts = ss_base.split('#', 1) -%}
{% set ss_path = ss_parts[0] -%}
{% set ss_frag = ('#' ~ ss_parts[1]) if ss_parts | length > 1 else '' -%}
{% set ss_join = '' if (ss_path.endswith('?') or ss_path.endswith('&')) else ('&' if '?' in ss_path else '?') -%}
{% set ss_url = ss_path ~ ss_join ~ 'panel=1&pid=' ~ snaphouse_host | default('panel') ~ '&ss=' ~ (1 if ss_cfg.enabled | default(false) else 0) ~ '&idle=' ~ ss_wait ~ '&nidle=' ~ ss_wait ~ '&qs=' ~ bl_cfg.quiet_start | default('22:00') ~ '&qe=' ~ bl_cfg.quiet_end | default('06:00') ~ ss_frag -%}
# {{ ansible_managed }}
# The hub URL the control panel opens. It comes from the untracked local config
# (panel_url in /etc/snaphouse/local.yml), so the household's address never lives
# in the repo. Unset it there to fall back to the hub's mDNS name. Set it to the
# hub's reserved IP if .local is not usable at boot on this network.
PANEL_URL={{ ss_url }}
