{#
  The page URL is built first (before the first output line) so the file keeps its
  shape. With the screensaver on, the panel query goes before any #fragment and is
  merged with a query already in panel_url. The page reads these parameters once at
  load, so a change to this file restarts the kiosk (Restart the kiosk service).
#}
{% set ss_base = panel_url | default('http://house.local/') -%}
{% set ss_on = (panel_screensaver | default({})).enabled | default(false) -%}
{% if ss_on -%}
{% set ss_parts = ss_base.split('#', 1) -%}
{% set ss_path = ss_parts[0] -%}
{% set ss_frag = ('#' ~ ss_parts[1]) if ss_parts | length > 1 else '' -%}
{% set ss_join = '' if (ss_path.endswith('?') or ss_path.endswith('&')) else ('&' if '?' in ss_path else '?') -%}
{% set ss_url = ss_path ~ ss_join ~ 'panel=1&idle=' ~ panel_screensaver.day_idle_s ~ '&nidle=' ~ panel_backlight.dim_timeout_s ~ '&qs=' ~ panel_backlight.quiet_start ~ '&qe=' ~ panel_backlight.quiet_end ~ ss_frag -%}
{% else -%}
{% set ss_url = ss_base -%}
{% endif -%}
# {{ ansible_managed }}
# The hub URL the control panel opens. It comes from the untracked local config
# (panel_url in /etc/snaphouse/local.yml), so the household's address never lives
# in the repo. Unset it there to fall back to the hub's mDNS name. Set it to the
# hub's reserved IP if .local is not usable at boot on this network.
PANEL_URL={{ ss_url }}
