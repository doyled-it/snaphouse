{#
  The backlight schedule daemon. It runs snaphouse.backlight from the on-device
  venv, dimming the official DSI display from this panel's own settings and waking
  it to Brightness on a touch. The settings come from the hub (panel-settings.json,
  read with the now-playing poll, with the last good copy cached on disk); the flags
  below are only the fallback for a panel with no cache and no hub, inlined from
  panel_backlight and panel_screensaver in vars/all.yml so one place in the repo
  owns the defaults. One wait (panel_screensaver.day_idle_s) covers day and night,
  so --dim-timeout takes it, not panel_backlight.dim_timeout_s. The daemon grabs the
  touchscreen only while dimmed to the night level with the screensaver off, unless
  panel_backlight.grab_wake_tap forces it (--force-grab). It also answers a
  loopback-only preview and refresh API on backlight_local_port, for the hub origin
  only (--allow-origin), derived from panel_url, the same URL the kiosk opens.
#}
{% set hub_origin = (panel_url | default('http://house.local/')).split('#')[0].split('?')[0].split('/')[0:3] | join('/') -%}
[Unit]
Description=Snaphouse panel backlight schedule
Documentation=https://github.com/doyled-it/snaphouse
After=sysinit.target
# No start rate limit: the backlight device (or the touchscreen) can bind late
# after a power cut, and the daemon exits when the backlight is not yet there.
# Unlimited restarts let it retry until the device appears rather than tripping
# systemd's default start limit and staying dead.
StartLimitIntervalSec=0

[Service]
Type=simple
# Reads the touchscreen under /dev/input and writes the sysfs backlight, both
# root-owned device nodes, so it runs as root. It is stdlib only.
Environment=PYTHONPATH=/opt/snaphouse/lib
Environment=SNAPHOUSE_HUB_ORIGIN={{ hub_origin }}
ExecStart=/opt/snaphouse/.venv/bin/python -m snaphouse.backlight --full-pct {{ panel_backlight.full_pct }} --dim-pct {{ panel_backlight.dim_pct }} --dim-timeout {{ (panel_screensaver | default({})).day_idle_s | default(panel_backlight.dim_timeout_s) }} --quiet-start {{ panel_backlight.quiet_start }} --quiet-end {{ panel_backlight.quiet_end }} --screensaver {{ 'on' if (panel_screensaver | default({})).enabled | default(false) else 'off' }} --screensaver-pct {{ (panel_screensaver | default({})).brightness_pct | default(40) }} --panel-id {{ snaphouse_host | default('panel') }} --settings-url ${SNAPHOUSE_HUB_ORIGIN}/panel-settings.json --local-port {{ backlight_local_port | default(8784) }} --allow-origin ${SNAPHOUSE_HUB_ORIGIN} --now-playing-url ${SNAPHOUSE_HUB_ORIGIN}/now-playing.json{{ ' --force-grab' if (panel_backlight.grab_wake_tap | default(false)) else '' }}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
