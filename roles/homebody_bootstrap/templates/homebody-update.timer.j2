# homebody self-update timer, managed by Ansible (roles/homebody_bootstrap). Do
# not edit on the host; change the template and let self-update roll it out.
#
# The same cadence snaphouse uses for its own self-update (vars/all.yml), so the
# hub keeps homebody current on main without a separate schedule to reason about.
[Unit]
Description=Run homebody self-update every {{ update_interval }}

[Timer]
# First run shortly after boot, then on the shared cadence from vars/all.yml. The
# random delay keeps it from waking at the same instant as snaphouse's own timer.
OnBootSec={{ update_interval }}
OnUnitActiveSec={{ update_interval }}
RandomizedDelaySec={{ update_randomized_delay }}
Persistent=true

[Install]
WantedBy=timers.target
