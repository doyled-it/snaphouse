{#
  Speaker buttons: reads the configured speaker's "(AVRCP)" input device and posts
  Stream.Control to snapserver (loopback on the hub, the hub's /jsonrpc proxy
  elsewhere). It passes the speaker *name*; the address is read from local.yml on
  the device and never appears here. It rescans by itself when the speaker
  disconnects and reconnects, so Restart=always only covers a crash.

  It runs unprivileged. local.yml is 0600 root (it holds the household's addresses
  and the art-share password), so a root-only ExecStartPre ("+" ignores User=)
  copies just the speaker's address into this unit's runtime directory, owned by
  the service user, and resolves the speaker's BlueZ Name into a "name" file beside
  it. The listener reads the name: BlueZ's "(AVRCP)" input devices have an empty
  uniq, so it matches the device called "<name> (AVRCP)". The service user gets the input
  group for /dev/input/event* (root:input 0660) and no capabilities. A speaker
  paired after the unit started is picked up because the listener returns after a
  long unpaired stretch and Restart=always reruns the ExecStartPre.
#}
{% set hub_name = snaphouse_hosts | dict2items | selectattr('value.roles', 'contains', 'hub_input') | map(attribute='key') | first %}
[Unit]
Description=snaphouse speaker buttons
After=bluetooth.service snaphouse-bt-keepalive.service
Wants=bluetooth.service

[Service]
Type=simple
Environment=PYTHONPATH=/opt/snaphouse/lib
Environment=PYTHONDONTWRITEBYTECODE=1
User=snaphouse-avrcp
Group=snaphouse-avrcp
SupplementaryGroups=input
RuntimeDirectory=snaphouse-avrcp-keys
RuntimeDirectoryMode=0750
ExecStartPre=+/opt/snaphouse/.venv/bin/python -m snaphouse.avrcp_keys {{ snaphouse_hosts[snaphouse_host].output.speaker }} --hub {{ hub_name }} --host {{ snaphouse_host }} --write-address /run/snaphouse-avrcp-keys/address
ExecStart=/opt/snaphouse/.venv/bin/python -m snaphouse.avrcp_keys {{ snaphouse_hosts[snaphouse_host].output.speaker }} --hub {{ hub_name }} --host {{ snaphouse_host }}
Restart=always
RestartSec=5

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
