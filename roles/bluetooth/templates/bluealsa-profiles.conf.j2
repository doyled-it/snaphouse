{#
  systemd drop-in for bluealsa.service. It replaces the packaged ExecStart with
  one that enables only the A2DP profiles this host needs:

    a2dp-sink    the host receives audio from a phone (the hub; it has a
                 bt_receive_adapter in local.yml)
    a2dp-source  the host sends audio to a Bluetooth speaker (output.kind is
                 "bluetooth": the hub to the Vizio, pi-bedroom to the JBL)

  The leading empty ExecStart= is required so systemd drops the packaged command
  before appending ours.
#}
{% set profiles = [] %}
{% if bt_receive_adapter is defined and bt_receive_adapter | length > 0 %}
{% set _ = profiles.append('a2dp-sink') %}
{% endif %}
{% if snaphouse_hosts[snaphouse_host].output.kind == 'bluetooth' %}
{% set _ = profiles.append('a2dp-source') %}
{% endif %}
[Service]
ExecStart=
ExecStart=/usr/bin/bluealsa{% for profile in profiles %} -p {{ profile }}{% endfor %}
