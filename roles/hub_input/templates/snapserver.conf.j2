# snapserver configuration, managed by Ansible (roles/hub_input). Do not edit on
# the host; change the template and let self-update roll it out.
#
# Two inputs feed one meta stream, all advertised as "{{ house_stream_name }}":
#   - AirPlay (Apple devices), carrying metadata and cover art.
#   - Bluetooth (Android), carrying AVRCP title/artist via the control script.
# The meta stream plays whichever input is active, AirPlay first when both are.
# Both inputs reach snapserver the same way: a program plays into an snd-aloop
# cable and snapserver captures the other end as an alsa:// source at the shared
# sample format. The pinned snapcast_version and the reason are in vars/all.yml.
#
# Both alsa sources carry idle_threshold (snapserver_idle_threshold_ms in
# vars/all.yml). snapserver's 100 ms default reads the digital silence between
# spoken sentences as the stream stopping, flapping the House meta stream and
# chopping every room during audiobooks and podcasts (issue #90); the higher
# value keeps speech pauses as playing while a real stop still goes idle.

[stream]
# Every member of the meta stream shares one sample format. Both the AirPlay and
# Bluetooth sources, and the global default, are pinned to the same value;
# otherwise the House stream mixes mismatched rates and plays at the wrong pitch.
# See house_sample_format in vars/all.yml.
sampleformat = {{ house_sample_format }}

# AirPlay in: the AirPlay 2 shairport-sync container (roles/hub_input, snaphouse-airplay-in
# service) plays into the loopback with soxr rate matching (hw:Loopback,0,1);
# this captures the other end (hw:Loopback,1,1)
# at the same format. snapserver does NOT launch shairport here: its own airplay
# source used shairport's stdout backend, which does no rate matching and drifts
# until snapserver resyncs (issue #38). The control script reads shairport's
# metadata pipe and publishes title/artist/album and a downscaled cover URL (never
# inline artData). It carries a venv shebang, so snapserver runs it with the
# on-device uv venv (which has Pillow, the hub-only extra).
source = alsa:///?name=AirPlay&device=hw:Loopback,1,1&sampleformat={{ house_sample_format }}&idle_threshold={{ snapserver_idle_threshold_ms }}&controlscript=/opt/snaphouse/lib/snaphouse/airplay_meta.py

# Bluetooth in: bluealsa-aplay decodes the phone's A2DP into the loopback at the
# shared sample format (hw:Loopback,0,0 via the snaphouse_bt_input ALSA device);
# this captures the other end (hw:Loopback,1,0) at the same format, so both ends
# of snd-aloop agree. The control script bridges the phone's AVRCP title/artist
# into the stream properties. It carries a venv shebang, so snapserver runs it
# with the on-device uv venv (which has the D-Bus library).
source = alsa:///?name=Bluetooth&device=hw:Loopback,1,0&sampleformat={{ house_sample_format }}&idle_threshold={{ snapserver_idle_threshold_ms }}&controlscript=/opt/snaphouse/lib/snaphouse/avrcp_meta.py

# The stream the rooms play: the active input, AirPlay winning a tie.
source = meta:///AirPlay/Bluetooth?name={{ house_stream_name }}

# The stream a client snapserver has never seen before is assigned to. Without
# this, snapserver defaults a new client to the first valid stream, which is
# AirPlay (the sources must be listed AirPlay, Bluetooth, House so the meta
# stream can reference the other two). That left every room on the bare AirPlay
# input instead of the house. Pin the default to the House meta stream.
default_source = {{ house_stream_name }}

[http]
# JSON-RPC, websockets, and the Snapweb control UI on the LAN. nginx proxies
# /jsonrpc here, and port 1780 stays reachable directly for the nightstand frame.
# No inbound access from the internet (AGENTS.md).
enabled = true
bind_to_address = 0.0.0.0
port = 1780
# Snapweb is used to tune per-room latency (design step 8).
doc_root = /usr/share/snapserver/snapweb
# snapserver's advertised HTTP host. Cover art no longer flows through snapserver
# (the AirPlay metadata bridge downscales it and publishes a /cover/ URL served
# by nginx), so this is just the host for Snapweb and the JSON-RPC endpoint.
host = {{ snaphouse_host }}.local
