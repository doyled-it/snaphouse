// shairport-sync configuration for the hub's AirPlay input. Managed by Ansible
// (roles/hub_input). Do not edit on the host; change the template.
//
// This file is mounted read-only into the official shairport-sync container
// (AirPlay 2, shairport-sync 5.x) as /etc/shairport-sync.conf by
// snaphouse-airplay-in.service. The container plays AirPlay audio into an ALSA
// loopback with soxr interpolation, so it rate-matches to the loopback clock the
// way a real sound card would; snapserver reads the other end as its "AirPlay"
// alsa:// source (issue #38 explains why not the stdout backend).
//
// The container has no host ALSA config, so the snaphouse plug device does not
// exist there: the loopback subdevice is opened directly and the shared format is
// pinned below. The sender's volume is applied in software (no ALSA mixer is
// named), so the whole house attenuates at the source, as before.

general = {
  name = "{{ house_stream_name }}";
  // soxr rate matching: shairport is built with soxr (checked on the hub). This
  // is what keeps the loopback from under/overflowing over time.
  interpolation = "soxr";
  output_backend = "alsa";
  // AirPlay 2 serves RTSP here (AirPlay 1 used 5000); the verify check probes it.
  port = {{ airplay_rtsp_port }};
  // Apply the AirPlay sender's volume to the audio (the default); with no mixer
  // named below, shairport attenuates in software. The sender controls the house
  // volume (model A).
  ignore_volume_control = "no";
  // Full scale at maximum sender volume, and a 30 dB control range. shairport's
  // default range (~60 dB) maps a mid sender volume to about -43 dB (near
  // silent); over 30 dB a mid sender volume lands near -15 dB, so the sender's
  // slider stays usable while the top still reaches full volume.
  volume_max_db = 0.0;
  volume_range_db = 30;
};

alsa = {
  // Loopback subdevice 1 (the Bluetooth input uses subdevice 0), pinned to the
  // house sample format 44100:16:2 so both ends of the loopback agree. No
  // mixer_control_name, so volume is software.
  output_device = "hw:Loopback,0,1";
  output_rate = 44100;
  output_format = "S16_LE";
  output_channels = 2;
};

metadata = {
  enabled = "yes";
  include_cover_art = "yes";
  // The AirPlay metadata bridge (lib/snaphouse/airplay_meta.py), run by
  // snapserver as the AirPlay stream's control script, reads this pipe and
  // republishes title/artist/album/playbackStatus and a downscaled cover URL.
  pipe_name = "/run/snaphouse/airplay-metadata";
  pipe_timeout = 5000;
};
